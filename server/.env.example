# ==============================================================================
# Siddhivinayak Charitable Trust - Backend Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# NEVER COMMIT .env OR REAL CREDENTIALS TO SOURCE CONTROL (GIT)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/siddhivinayak_trust?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secrets (Use strong 256-bit cryptographically secure random strings)
# Generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production

# JWT Expiration Periods
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Razorpay Payment Gateway Configuration (Server-Side Only)
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the client
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gemini AI Configuration (Server-Side Only - for Donation Allocation & Impact Assistant)
# Never expose GEMINI_API_KEY to the browser
GEMINI_API_KEY=

# SMTP Email Configuration (Server-Side Only)
# Never expose SMTP credentials or email passwords to the browser
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=donations@siddhivinayaktrust.org
EMAIL_FROM_NAME="Shree Siddhivinayak Charitable Trust"
EMAIL_SECURE=false

# Cloudinary Cloud Storage Configuration (Server-Side Only)
# Never expose CLOUDINARY_API_SECRET or API credentials to the browser or client-side code
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
