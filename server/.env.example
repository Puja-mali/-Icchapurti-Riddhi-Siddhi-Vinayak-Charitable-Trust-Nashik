# ==============================================================================
# ICCHAPURTI RIDDHI SIDDHI VINAYAK CHARITABLE TRUST, NASHIK
# Backend Environment Configuration Template (server/.env.example)
#
# Registration Number: E/1341
# Copy to 'server/.env' and supply genuine credentials for live deployment.
# NEVER commit the real .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME (Required)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-production-domain.org

# Set to 1 if behind a reverse proxy / Cloud Run / Kubernetes ingress
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. PERSISTENT DATABASE CONFIGURATION (Mandatory for Production)
# Target Database: 'siddhivinayak' cluster in MongoDB Atlas
# Production strictly fails if MONGODB_URI is absent.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/siddhivinayak?retryWrites=true&w=majority

# Optional: set to 'true' in development to force local in-memory DB testing
USE_IN_MEMORY_DB=false

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (Mandatory for Production)
# Generate high-entropy 64+ character random strings:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production startup terminates immediately if dev default secrets are used.
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_production_high_entropy_jwt_access_secret_64_chars_min
JWT_REFRESH_SECRET=your_production_high_entropy_jwt_refresh_secret_64_chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_DOMAIN=
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 4. API RATE LIMITING (Recommended for Production Hardening)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay — Currently Enforced in Test Mode)
# Keep in Test Mode (keys starting with 'rzp_test_') until Trust authorization.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL TRANSPORTS (SMTP / Nodemailer)
# Required for password reset emails and official donor electronic receipts.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@siddhivinayaktrust.org
SMTP_PASS=placeholder_smtp_app_password
EMAIL_FROM=contact@siddhivinayaktrust.org
ADMIN_NOTIFICATION_EMAIL=admin@siddhivinayaktrust.org

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (VAPID Keys)
# Generate new pair using: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=placeholder_vapid_public_key
VAPID_PRIVATE_KEY=placeholder_vapid_private_key
VAPID_SUBJECT=mailto:contact@siddhivinayaktrust.org

# ------------------------------------------------------------------------------
# 8. CLOUD MEDIA & DOCUMENT STORAGE (Cloudinary)
# Required for persistent field photo uploads and transparency PDF dockets.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=placeholder_cloudinary_name
CLOUDINARY_API_KEY=placeholder_cloudinary_key
CLOUDINARY_API_SECRET=placeholder_cloudinary_secret
CLOUDINARY_FOLDER=siddhivinayak_trust

# ------------------------------------------------------------------------------
# 9. AI ADVISORY & MULTILINGUAL LOCALIZATION (Gemini / Google Translate)
# Strictly advisory; privacy-guarded so beneficiary PII is never transmitted.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_TRANSLATE_API_KEY=
