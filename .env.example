# ==============================================================================
# ICCHAPURTI RIDDHI SIDDHI VINAYAK CHARITABLE TRUST, NASHIK
# Root Environment Configuration Template (.env.example)
#
# Registration Number: E/1341
# Copy to '.env' for local development or configure in your deployment platform.
# NEVER commit real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vite Client Env)
# ------------------------------------------------------------------------------
# Leave empty for unified single-port architecture (/api proxying)
VITE_API_URL=
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
VITE_VAPID_PUBLIC_KEY=placeholder_vapid_public_key

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MongoDB Atlas)
# Mandatory for production deployment. Target DB: 'siddhivinayak'
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/siddhivinayak?retryWrites=true&w=majority
USE_IN_MEMORY_DB=false

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT CRYPTOGRAPHY
# Mandatory for production: 64+ char random strings
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_production_high_entropy_jwt_access_secret_64_chars_min
JWT_REFRESH_SECRET=your_production_high_entropy_jwt_refresh_secret_64_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay — Test Mode Only)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=contact@siddhivinayaktrust.org
EMAIL_PASSWORD=placeholder_smtp_app_password
EMAIL_FROM=contact@siddhivinayaktrust.org
EMAIL_FROM_NAME="Icchapurti Riddhi Siddhi Vinayak Charitable Trust"

# ------------------------------------------------------------------------------
# 8. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=placeholder_vapid_public_key
VAPID_PRIVATE_KEY=placeholder_vapid_private_key
VAPID_SUBJECT=mailto:contact@siddhivinayaktrust.org

# ------------------------------------------------------------------------------
# 9. CLOUD MEDIA STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=placeholder_cloudinary_name
CLOUDINARY_API_KEY=placeholder_cloudinary_key
CLOUDINARY_API_SECRET=placeholder_cloudinary_secret

# ------------------------------------------------------------------------------
# 10. AI ASSISTANCE (Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=placeholder_gemini_api_key